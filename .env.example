# Copy to .env, every service reads configuration from environment only.

# --- LLM (optional: leave the key empty and the platform runs in
# --- deterministic fallback mode; nothing breaks, the "AI" badge turns off)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_TIMEOUT_MS=2500
# Global daily cap on LLM calls across the platform (spend protection for
# public demos). When exceeded, services fall back to deterministic mode.
LLM_DAILY_CALL_BUDGET=2000

# --- Backing stores (compose defaults)
DATABASE_URL=postgres://fernweh:fernweh@localhost:5432/fernweh?sslmode=disable
REDIS_ADDR=localhost:6379

# --- Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true

# --- Service addresses (compose overrides these to service-DNS names)
SEARCH_ADDR=:8081
RANKING_ADDR=:8082
ENRICH_ADDR=:8083
GATEWAY_ADDR=:8080
SEARCH_URL=http://localhost:8081
RANKING_URL=http://localhost:8082
ENRICH_URL=http://localhost:8083

# --- Gateway protection
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=15

# --- Public Jaeger UI address the frontend links to
JAEGER_UI_URL=http://localhost:16686

# --- Betterstack (optional). With a source token set, every service ships
# --- its JSON logs to Betterstack Logs; stdout remains authoritative.
# --- A heartbeat URL makes Betterstack Uptime alert if the platform dies.
BETTERSTACK_LOG_TOKEN=
BETTERSTACK_INGEST_HOST=in.logs.betterstack.com
BETTERSTACK_HEARTBEAT_URL=
